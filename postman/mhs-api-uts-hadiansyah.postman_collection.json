                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const hasil = pm.response.json();",
                  "pm.test(\"bentuk JSON status/message/data\", () => pm.expect(hasil).to.have.all.keys(\"status\", \"message\", \"data\"));",
